{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CallOnlyClaudeModelsOnBedrock",
      "Effect": "Allow",
      "Action": [
        "bedrock:InvokeModel",
        "bedrock:InvokeModelWithResponseStream"
      ],
      "Resource": "arn:aws:bedrock:us-east-1::foundation-model/anthropic.claude-*"
    },
    {
      "Sid": "ReadOnlyTheCustomerDocsFolder",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::acme-ai-docs/customer-docs/*"
    },
    {
      "Sid": "ListOnlyThatFolder",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::acme-ai-docs",
      "Condition": {
        "StringLike": {
          "s3:prefix": "customer-docs/*"
        }
      }
    },
    {
      "Sid": "ReadOnlyOurOwnSecret",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": "arn:aws:secretsmanager:us-east-1:123456789012:secret:prod/ai-app/anthropic-api-key-*"
    }
  ]
}
