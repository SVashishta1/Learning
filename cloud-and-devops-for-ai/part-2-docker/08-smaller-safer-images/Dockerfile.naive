# The "first try" Dockerfile. It works, but it is big, slow to rebuild and runs as root.
# Build it only to compare with ./Dockerfile:
#   docker build -f Dockerfile.naive -t mood-api:naive .

FROM python:3.12
WORKDIR /app
COPY . .
RUN pip install -r requirements.txt
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
