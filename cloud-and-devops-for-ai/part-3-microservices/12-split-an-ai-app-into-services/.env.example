# Copy this file to ".env" (same folder) ONLY if you want real Claude answers.
# Docker Compose reads .env automatically. Never commit .env to git.

# 1 = fake answers (free, no key). 0 = real answers from Claude.
FAKE_LLM=0
# Your key from https://console.anthropic.com (starts with sk-ant-)
ANTHROPIC_API_KEY=sk-ant-REPLACE-ME
# claude-opus-5-5 (best) or claude-haiku-5-5 (much cheaper)
CLAUDE_MODEL=claude-opus-5-5
